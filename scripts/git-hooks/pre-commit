#!/bin/sh
set -eu

if ! command -v clang-format >/dev/null 2>&1; then
  echo "pre-commit: clang-format is required but was not found" >&2
  exit 1
fi

files=$(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '^msdos/(include|src|tests)/.*\.(c|h|cpp)$' |
    grep -v '^msdos/tests/doctest\.h$' || true
)

if [ -z "$files" ]; then
  exit 0
fi

printf '%s\n' "$files" | while IFS= read -r file; do
  [ -f "$file" ] || continue
  clang-format -i "$file"
  git add "$file"
done
